    "LanguageModel": {
      "additionalProperties": false,
      "description": "An HF CausalLM plus its tokenizer, with layer-capturing forward + unembed.",
      "properties": {
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "dtype": {
          "default": "bf16",
          "enum": [
            "bf16",
            "fp16",
            "fp32"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "attn_impl": {
          "default": "sdpa",
          "title": "Attn Impl",
          "type": "string"
        },
        "trust_remote_code": {
          "default": true,
          "title": "Trust Remote Code",
          "type": "boolean"
        },
        "lora": {
          "anyOf": [
            {
              "$ref": "#/$defs/LoraSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "model_id"
      ],
      "title": "LanguageModel",
      "type": "object"
    },
    "LaunchConfig": {
      "additionalProperties": false,
      "description": "How to launch: process count + extra env. The trainer type is fixed to\n``opd`` (opdlens has a single trainer; no polymorphic registry).",
      "properties": {
        "type": {
          "default": "opd",
          "title": "Type",
          "type": "string"
        },
        "devices": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "const": "all",
              "type": "string"
            }
          ],
          "default": "all",
          "title": "Devices"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Env",
          "type": "object"
        }
      },
      "title": "LaunchConfig",
      "type": "object"
    },
