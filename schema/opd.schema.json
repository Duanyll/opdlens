      "properties": {
        "class_name": {
          "description": "torch.optim class name (e.g. AdamW).",
          "type": "string"
        },
        "lr": {
          "description": "Learning rate.",
          "type": "number"
        }
      },
      "required": [
        "class_name"
      ],
      "title": "Optimizer Config",
      "type": "object"
    },
    "scheduler_config": {
      "additionalProperties": true,
      "default": {
        "class_name": "ConstantLR",
        "factor": 1.0
      },
      "properties": {
        "class_name": {
