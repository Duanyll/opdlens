    "LoraSpec": {
      "additionalProperties": false,
      "description": "LoRA adapter config for the student. When set, only the adapter trains; the\nbase model is frozen. Defaults mirror ms-swift's GKD LoRA recipe (rank 8, alpha\n32, all-linear). The colocated vLLM engine is synced with MERGED weights, so the\nreproduction stays a drop-in swap of ``full`` fine-tune for ``lora`` regularized.",
      "properties": {
        "r": {
          "default": 8,
          "title": "R",
          "type": "integer"
        },
        "alpha": {
          "default": 32,
          "title": "Alpha",
          "type": "integer"
        },
        "dropout": {
          "default": 0.05,
          "title": "Dropout",
          "type": "number"
        },
        "target_modules": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "default": "all-linear",
          "title": "Target Modules"
        }
      },
      "title": "LoraSpec",
      "type": "object"
    },
