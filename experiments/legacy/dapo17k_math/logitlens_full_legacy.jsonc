{
  "$schema": "../../../schema/opd.schema.json",
  "launch": {
    "type": "opd",
    "devices": 2,
    "env": {
      "HF_HUB_OFFLINE": "1",
      "HF_DATASETS_OFFLINE": "1",
      "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
    }
  },
  "experiment_name": "logitlens-full-legacy-chunk256vllm020",
  "trackio_project": "opdlens-math",
  "seed": 42,
  "student": {
    "model_id": "Qwen/Qwen3.5-2B",
    "dtype": "bf16",
    "attn_impl": "sdpa"
  },
  "teacher": {
    "model_id": "Qwen/Qwen3.5-9B",
    "dtype": "bf16",
    "attn_impl": "sdpa"
  },
  "arm": {
    "type": "logit_lens",
    "aux_weight": 0.01,
    "aux_token_policy": "shared",
    "teacher_layers": [
      8,
      16,
      24
    ],
    "temperature": 1.0
  },
  "base_beta": 0.0,
  "base_temperature": 1.0,
  "enable_thinking": false,
  "train_benchmark": {
    "type": "dapo_math",
    "hf_id": "open-r1/DAPO-Math-17k-Processed",
    "hf_name": "all",
    "hf_revision": "31dd309567e3da778038cc87d868b6097a3ccf68",
    "split": "train",
    "system_prompt": "Solve the following problem step by step. Put your final answer within \\boxed{}."
  },
  "eval_benchmarks": [
    {
      "type": "math",
      "hf_id": "EleutherAI/hendrycks_math",
      "hf_revision": "21a5633873b6a120296cce3e2df9d5550074f4a3",
      "subjects": [
        "algebra",
        "counting_and_probability",
        "geometry",
        "intermediate_algebra",
        "number_theory",
        "prealgebra",
        "precalculus"
      ],
      "split": "test",
      "system_prompt": "Solve the following problem step by step. Put your final answer within \\boxed{}.",
      "eval_temperature": 0.0,
      "eval_top_p": 1.0,
      "avg_k": 1,
      "eval_max_tokens": 2048
    }
  ],
  "eval_max_samples": null,
  "rollout_backend": "vllm",
  "rollout_temperature": 1.0,
  "rollout_top_p": 1.0,
  "rollout_max_tokens": 512,
  "vllm_gpu_memory_utilization": 0.2,
  "vllm_max_model_len": 4096,
  "vllm_enforce_eager": false,
  "global_batch_size": 8,
  "rollouts_per_prompt": 1,
  "train_steps": 300,
  "eval_steps": 100,
  "eval_at_start": true,
  "checkpoint_interval": 100,
  "checkpoint_root": "/gdata/users/duanyll/opdlens/ckpt/dapo17k-math/logitlens-full-legacy-chunk256vllm020",
  "optimizer_config": {
    "class_name": "AdamW",
    "lr": 2e-06,
    "betas": [
      0.9,
      0.999
    ],
    "weight_decay": 0.0
  },
  "scheduler_config": {
    "class_name": "ConstantLR",
    "factor": 1.0
  },
  "clip_grad_norm": 1.0,
  "base_loss_chunk_size": 256
}
