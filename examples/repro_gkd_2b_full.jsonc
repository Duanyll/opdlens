{
  // Reproduction of the ms-swift on-policy distillation (GKD, lmbda=1) baseline:
  //   Qwen3.5-9B teacher -> Qwen3.5-2B student, GSM8K, JSD(beta=0.5) @ temp 0.9.
  // Target curve (EvalScope 4-shot GSM8K, pass@1): 0.7597 -> 0.7968 -> 0.8188 -> 0.8332
  // at steps 0/100/200/300. This is the FULL fine-tune variant (see *_lora for LoRA).
  "$schema": "../schema/opd.schema.json",
  "launch": { "type": "opd", "devices": 1, "env": { "HF_HUB_OFFLINE": "1" } },
  "experiment_name": "repro-gkd-2b-full",
  "trackio_project": "opdlens-repro-gkd",
  "seed": 42,

  "student": { "model_id": "Qwen/Qwen3.5-2B", "dtype": "bf16", "attn_impl": "sdpa" },
  "teacher": { "model_id": "Qwen/Qwen3.5-9B", "dtype": "bf16", "attn_impl": "sdpa" },

  // Arm A (plain OPD). base_beta=0.5 -> JSD; base_temperature=0.9 -> ms-swift GKD.
  "arm": { "type": "logits" },
  "base_beta": 0.5,
  "base_temperature": 0.9,
  "enable_thinking": false,

  // Training rollout: zero-shot raw GSM8K question (ms-swift `--dataset gsm8k` style).
  "train_benchmark": { "type": "gsm8k", "split": "train", "system_prompt": null },

  // Eval: EvalScope default GSM8K = 4-shot CoT + "\\boxed{}" instruction, no system,
  // greedy (temp 0), pass@1, full 1319 test. Validated: untrained 2B -> 0.755 (~0.7597).
  "eval_benchmarks": [
    {
      "type": "gsm8k",
      "split": "test",
      "system_prompt": null,
      "few_shot_num": 4,
      "answer_instruction": "Please reason step by step, and put your final answer within \\boxed{}.",
      "eval_temperature": 0.0,
      "eval_top_p": 1.0,
      "avg_k": 1,
      "eval_max_tokens": 2048
    }
  ],
  "eval_max_samples": null,

  "rollout_backend": "vllm",
  "rollout_temperature": 0.9,
  "rollout_top_p": 1.0,
  // GSM8K zero-shot thinking-off completions are short; 768 bounds the full-vocab
  // loss memory (V~151k) while virtually never truncating a real solution.
  "rollout_max_tokens": 768,
  "vllm_gpu_memory_utilization": 0.25,
  "vllm_max_model_len": 4096,

  // Global batch 96 = ms-swift (per_device 2 * grad_accum 16 * 3 GPUs). Held constant
  // across GPU counts: per-rank prompts = 96 / world_size, so ONLY changing --gpus
  // leaves the training dynamics identical.
  "global_batch_size": 96,
  "rollouts_per_prompt": 1,

  "train_steps": 300,
  "eval_steps": 100,
  "eval_at_start": true,
  "checkpoint_interval": 100,
  "checkpoint_root": "/gdata/users/duanyll/opdlens/ckpt/repro-gkd-2b-full",

  // Full fine-tune. ms-swift's documented LoRA lr is 5e-5; full-FT needs a smaller lr
  // (starting point — tune against the curve). betas/wd/warmup match ms-swift GKD.
  "optimizer_config": {
    "class_name": "AdamW",
    "lr": 5e-6,
    "betas": [0.9, 0.95],
    "weight_decay": 0.1
  },
  "scheduler_config": {
    "class_name": "get_cosine_schedule_with_warmup",
    "num_warmup_steps": 30,
    "num_training_steps": 300
  },
  "clip_grad_norm": 1.0
}
